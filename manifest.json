{
  "manifest_version": 3,
  "name": "재생목록 → 노트북 보내기",
  "version": "1.0.0",
  "description": "유튜브 재생목록의 영상 URL을 추출해 노트북(NotebookLM)에 소스로 일괄 추가합니다. 비공식 도구입니다.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://notebooklm.google.com/*",
    "https://notebook.google.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "노트북으로 보내기",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://notebooklm.google.com/*",
        "https://notebook.google.com/*"
      ],
      "js": [
        "content-notebooklm.js"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
